  background(fondo2);
  fill(0);
  rect (20, 20, 610,60);
    fill(255);
  text("Mientras Santuki estaba en la escuela y su padre trabajaba, Mei decidió explorar el\nbosque cercano.Siguiendo unas pequeñas criaturas, termian cayendo dentro\nde una madriguera donde decubre a una enorme\ncriatura: el espiritu del bosque Desde entonces decide llamarlo Totoro.", 300, 50);
}
